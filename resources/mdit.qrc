<!DOCTYPE RCC>
<!-- mdit's compiled-in application icon.
     The PNGs are generated by tools/make_icon.py (white disc + '#' mark, one
     natively rendered file per size); this file embeds them so the app has no
     external icon dependency at runtime (AUTORCC compiles it into the binary). -->
<RCC version="1.0">
    <qresource prefix="/icons">
        <file alias="mdit-16.png">../assets/icons/mdit-16.png</file>
        <file alias="mdit-24.png">../assets/icons/mdit-24.png</file>
        <file alias="mdit-32.png">../assets/icons/mdit-32.png</file>
        <file alias="mdit-48.png">../assets/icons/mdit-48.png</file>
        <file alias="mdit-64.png">../assets/icons/mdit-64.png</file>
        <file alias="mdit-128.png">../assets/icons/mdit-128.png</file>
        <file alias="mdit-256.png">../assets/icons/mdit-256.png</file>
        <file alias="mdit-512.png">../assets/icons/mdit-512.png</file>
    </qresource>
</RCC>
